\section{Introduzione}

\begin{frame}[c]
    \frametitle{Introduzione}

    \begin{columns}[T,onlytextwidth]

        \begin{column}{0.47\textwidth}

            \begin{block}{Rappresentazione di un gruppo}

                \begin{minipage}[t][0.70\textheight][t]{\linewidth}

                    Sia $(G,\cdot)$ un gruppo e $V$ uno spazio vettoriale.
                    Una rappresentazione di $G$ su $V$ è un omomorfismo

                    \[
                        D:G\longrightarrow GL(V)
                    \]

                    dunque

                    \[
                        D(g_1g_2)=D(g_1)D(g_2),
                        \qquad g_1,g_2\in G.
                    \]

                    Scelta una base di $V$, ogni $D(g)$ è rappresentato
                    da una matrice invertibile.

                \end{minipage}

            \end{block}

        \end{column}

        \hfill

        \begin{column}{0.47\textwidth}

            \begin{exampleblock}{Rappresentazione riducibile}

                \begin{minipage}[t][0.70\textheight][t]{\linewidth}

                    $D$ è riducibile se esiste un sottospazio proprio
                    non banale $W\subset V$ tale che

                    \[
                        D(g)W\subseteq W,
                        \qquad \forall g\in G.
                    \]

                    Nel caso completamente riducibile,

                    \[
                        D(g)=
                        \begin{pmatrix}
                            D_1(g) & 0      & \cdots & 0 \\
                            0      & D_2(g) & \cdots & 0 \\
                            \vdots & \vdots & \ddots & \vdots \\
                            0      & 0      & \cdots & D_r(g)
                        \end{pmatrix}.
                    \]

                \end{minipage}

            \end{exampleblock}

        \end{column}

    \end{columns}

\end{frame}

