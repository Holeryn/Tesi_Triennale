\begin{frame}[c]
    \frametitle{Interpretazione per $m=0$ e $W^2=-\rho^2$}

    \begin{columns}[T,onlytextwidth]

        %----------------------------------------
        % Colonna sinistra
        %----------------------------------------
        \begin{column}{0.50\textwidth}

            \begin{block}{Generatori}

                Per $p^\mu=(E,0,0,E)$ definiamo
                \[
                    X_\pm \equiv (M_{01}-M_{31}) \pm i(M_{02}+M_{23}).
                \]

                Se
                \[
                    M_{12}\ket{h}=h\ket{h},
                \]
                allora, usando
                \[
                    [M_{12},X_\pm]=\pm X_\pm,
                \]
                si ottiene
                \[
                    X_+\ket{h}\propto \ket{h+1},
                    \qquad
                    X_-\ket{h}\propto \ket{h-1}.
                \]

            \end{block}

            \begin{alertblock}{Conclusione}
                Gli operatori $X_\pm$ collegano stati con elicità diverse:
                \[
                    h \longrightarrow h\pm 1.
                \]
                L'irrep contiene quindi una \textbf{torre infinita di elicità}.
            \end{alertblock}

        \end{column}

        \hfill
        %----------------------------------------
        % Colonna destra

        \begin{column}{0.56\textwidth}
   \vspace{-0.95cm}
