\section{Operatori di Casimir}

\begin{frame}[c]
    \frametitle{Operatori di Casimir}

    \begin{block}{Vettore di Pauli--Lubanski}
        \[
            W^\mu
            =
            \frac{1}{2}
            \epsilon^{\mu\nu\rho\sigma}
            P_\nu M_{\rho\sigma}
        \]
    \end{block}

    \begin{exampleblock}{Operatori di Casimir}
        \[
            \mathcal{C}
            =
            \left\{
                P_\mu P^\mu,
                \;
                W_\mu W^\mu
            \right\}
        \]
    \end{exampleblock}

    \begin{block}{Algebra dei Casimir}
        \[
            [P_\mu P^\mu,P^\rho]=0,
            \qquad
            [P_\mu P^\mu,M^{\rho\sigma}]=0
        \]

        \[
            [W_\mu W^\mu,P^\rho]=0,
            \qquad
            [W_\mu W^\mu,M^{\rho\sigma}]=0
        \]

        \[
            [P_\mu P^\mu,W_\nu W^\nu]=0
        \]
    \end{block}

\end{frame}


