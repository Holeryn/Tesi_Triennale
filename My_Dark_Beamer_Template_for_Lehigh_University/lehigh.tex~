\section{Conclusioni}

\begin{frame}[c]
    \frametitle{Tachioni e conclusioni}

    %----------------------------------------
    % Tachioni
    %----------------------------------------
    \begin{block}{Rappresentazioni tachioniche}
        \vspace{-0.15cm}

        \[
            p^\mu=(0,0,0,\mu),
            \qquad
            p_\mu p^\mu=-\mu^2<0
        \]

        \vspace{-0.25cm}
    \end{block}

    \vspace{0.35cm}

    %----------------------------------------
    % Classificazione finale
    %----------------------------------------
    \begin{exampleblock}{Classificazione delle rappresentazioni irriducibili}

        \[
        \left\{
        \begin{array}{lll}

            P_\mu P^\mu=m^2>0
            &:
            &
            |m,s\rangle,
            \qquad
            s=0,\frac12,1,\frac32,\ldots
            \\[0.8em]

            P_\mu P^\mu=0,\quad W^2=0
            &:
            &
            |h\rangle,
            \qquad
            h=\pm s
            \\[0.8em]

            P_\mu P^\mu=0,\quad W^2=-\rho^2
            &:
            &
            \text{spin continuo}
            \\[0.8em]

            P_\mu P^\mu=-\mu^2<0
            &:
            &
            \text{tachioni}

        \end{array}
        \right.
        \]

    \end{exampleblock}

\end{frame}
