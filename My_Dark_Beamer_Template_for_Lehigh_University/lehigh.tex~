\section{Gruppo di Poincaré}

\begin{frame}[t]

    \frametitle{Gruppo di Poincaré}
    \vspace{-0.6cm}

    \begin{columns}[T,onlytextwidth]

        %----------------------------------------
        % COLONNA SINISTRA
        %----------------------------------------

        \begin{column}{0.48\textwidth}

            \begin{exampleblock}{Trasformazioni di Poincaré}

                \begin{minipage}[t][0.76\textheight][t]{\linewidth}

                    \[
                        x'^{\mu}
                        =
                        \Lambda^{\mu}{}_{\nu}x^{\nu}
                        +
                        a^{\mu}
                    \]

                    Per trasformazioni infinitesime:

                    \[
                        \Lambda^{\mu}{}_{\nu}
                        =
                        \delta^{\mu}{}_{\nu}
                        +
                        \omega^{\mu}{}_{\nu},
                        \qquad
                        |\omega^{\mu}{}_{\nu}|\ll 1
                    \]

                    \vspace{-0.2cm}

                    \[
                        \delta x^\mu
                        =
                        a^\mu
                        +
                        \omega^\mu{}_{\nu}x^\nu
                    \]

                    \vspace{-0.15cm}

                    Dalla condizione di Lorentz

                    \[
                        \Lambda^T\eta\Lambda=\eta
                        \quad\Rightarrow\quad
                        \omega_{\mu\nu}
                        =
                        -\omega_{\nu\mu}
                    \]

                    \vspace{-0.15cm}

                    quindi i generatori sono

                    \[
                        \begin{gathered}
                            P^0,\ P^1,\ P^2,\ P^3
                            \\[-0.35em]
                            M^{01},M^{02},M^{03},
                            M^{12},M^{23},M^{31}.
                        \end{gathered}
                    \]

                \end{minipage}

            \end{exampleblock}

        \end{column}

        \hfill

        %----------------------------------------
        % COLONNA DESTRA
        %----------------------------------------

        \begin{column}{0.47\textwidth}

            \begin{block}{Generatori}

                \[
                    P^\mu=-i\partial^\mu
                \]

                \vspace{-0.25cm}

                \[
                    \left(M^{\mu\nu}\right)^\alpha{}_{\beta}
                    =
                    -i\left(
                        \eta^{\mu\alpha}\delta^\nu_{\beta}
                        -
                        \eta^{\nu\alpha}\delta^\mu_{\beta}
                    \right)
                \]

            \end{block}

            \begin{block}{Algebra di Poincaré}

                \begin{minipage}[t][0.45\textheight][t]{\linewidth}

                    \[
                        \bigl[P^\mu,P^\nu\bigr]=0
                    \]

                    \[
                        \bigl[M^{\mu\nu},P^\rho\bigr]
                        =
                        i\left(
                            g^{\nu\rho}P^\mu
                            -
                            g^{\mu\rho}P^\nu
                        \right)
                    \]

                    \[
                        \begin{aligned}
                        \bigl[M^{\mu\nu},M^{\rho\sigma}\bigr]
                        =
                        i\bigl(
                        &g^{\nu\rho}M^{\mu\sigma}
                        -
                        g^{\mu\rho}M^{\nu\sigma}
                        \\
                        &-
                        g^{\nu\sigma}M^{\mu\rho}
                        +
                        g^{\mu\sigma}M^{\nu\rho}
                        \bigr)
                        \end{aligned}
                    \]

                \end{minipage}

            \end{block}

        \end{column}

    \end{columns}

\end{frame}

