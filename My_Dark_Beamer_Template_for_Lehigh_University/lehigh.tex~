\section{Particelle massless}

\begin{frame}[c]
    \frametitle{Interpretazione per $m=0$}

    Per $m=0$ si presentano due possibilità per il secondo Casimir:

    \[
        W_\mu W^\mu = 0
        \qquad\text{oppure}\qquad
        W_\mu W^\mu = -\rho^2.
    \]

    \begin{block}{Particelle massless}

        Nel caso $W_\mu W^\mu=0$:

        \[
            \begin{aligned}
                W_\mu W^\mu |p\rangle &= 0,\\[-0.25em]
                W_\mu P^\mu |p\rangle &= 0,\\[-0.25em]
                P_\mu P^\mu |p\rangle &= 0
            \end{aligned}
        \]

        \vspace{-0.35cm}

        \[
            \therefore
            \qquad
            W^\mu |p\rangle
            =
            h\,P^\mu |p\rangle
        \]

    \end{block}

    \begin{exampleblock}{Elicità}
        \[
            h
            =
            \frac{\mathbf{J}\cdot\mathbf{P}}
                 {|\mathbf{P}|}
        \]
    \end{exampleblock}

\end{frame}

