% ELICITA
%================================================

\begin{frame}[c]
    \frametitle{Elicità per $m=0$ e $W^2 = 0$}

    \begin{columns}[T,onlytextwidth]

        \begin{column}{0.47\textwidth}

            \begin{exampleblock}{Elicità positiva}

                \[
                    W^\mu=hP^\mu,
                    \qquad h>0
                \]

                \begin{center}
                \begin{tikzpicture}[scale=1.0]
                    \filldraw (0,0) circle (2pt);

                    \draw[->,thick]
                        (0,0) -- (3.5,0)
