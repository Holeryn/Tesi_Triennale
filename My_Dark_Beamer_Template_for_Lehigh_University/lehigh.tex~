\section{Particelle massive}

\begin{frame}[c]
    \frametitle{Interpretazione di $W_\mu W^\mu$ per $m\neq0$}

    \begin{block}{Sistema di riferimento a riposo}

        Consideriamo un sistema di riferimento solidale ad una
        particella massiva:

        \[
            P^\mu=(m,\mathbf{0})
        \]

        In tale sistema:

        \[
            W_i
            =
            -\frac{1}{2}
            m\,\epsilon_{ijk0}M^{jk}
            =
            -mL_i,
            \qquad
            W_0=0
        \]

    \end{block}

    \begin{exampleblock}{Interpretazione}

        $\mathbf{W}$ è legato al Casimir di $SO(3)$. Pertanto:

        \[
            \mathbf{W}^{\,2}
            =
            m^2 S(S+1)
        \]

    \end{exampleblock}

\end{frame}

