                    \draw[->,thick]
                        (0,0.35) -- (3.5,0.35)
                        node[right] {$W^\mu$};
                \end{tikzpicture}
                \end{center}

                \[
                    W^\mu\parallel P^\mu
                \]

            \end{exampleblock}

        \end{column}

        \hfill

        \begin{column}{0.47\textwidth}

            \begin{block}{Elicità negativa}

                \[
                    W^\mu=hP^\mu,
                    \qquad h<0
                \]

                \begin{center}
                \begin{tikzpicture}[scale=1.0]
                    \filldraw (1.75,0) circle (2pt);

                    \draw[->,thick]
                        (1.75,0) -- (3.5,0)
                        node[right] {$P^\mu$};

                    \draw[->,thick]
                        (1.75,0.35) -- (0,0.35)
                        node[left] {$W^\mu$};
                \end{tikzpicture}
                \end{center}

                \[
                    W^\mu\parallel -P^\mu
                \]

            \end{block}

        \end{column}

    \end{columns}

\end{frame}


